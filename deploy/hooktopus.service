# Runs HOOKtopus straight from a checkout, as an alternative to Docker.
#
# All paths below are examples. Adjust them to your install, then:
#
#   sudo useradd --system --home /opt/hooktopus --shell /usr/sbin/nologin hooktopus
#   sudo mkdir -p /srv/hooktopus/data && sudo chown hooktopus: /srv/hooktopus/data
#   cd /opt/hooktopus && npm ci && npm run build
#   sudo cp deploy/hooktopus.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hooktopus
#   journalctl -u hooktopus -f

[Unit]
Description=HOOKtopus webhook catcher
Documentation=https://github.com/apvwbm/hooktopus
After=network-online.target
Wants=network-online.target

[Service]
User=hooktopus
Group=hooktopus
WorkingDirectory=/opt/hooktopus
# HOOKTOPUS_DATA_DIR=/srv/hooktopus/data, HOOKTOPUS_PUBLIC_URL and
# HOOKTOPUS_TRUST_PROXY=true behind the reverse proxy. See .env.example.
EnvironmentFile=/opt/hooktopus/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5

# src/index.ts closes cleanly on SIGTERM; open live streams are hung up first.
KillSignal=SIGTERM
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/hooktopus/data

[Install]
WantedBy=multi-user.target
