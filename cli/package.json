  "keywords": [
    "webhook",
    "forward",
    "localhost",
    "tunnel",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apvwbm/hooktopus.git",
    "directory": "cli"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
