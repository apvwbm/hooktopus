{
  "name": "hooktopus",
  "version": "0.1.0",
  "description": "Forward webhooks caught by HOOKtopus to your local server",
  "type": "module",
  "bin": {
    "hooktopus": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc",
