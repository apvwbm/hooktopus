# Listening port.
HOOKTOPUS_PORT=8080

# Single data directory. /data in Docker, ./data in development.
HOOKTOPUS_DATA_DIR=./data

# Public base URL, used to build the capture and view URLs the API hands out.
HOOKTOPUS_PUBLIC_URL=http://localhost:8080

# Set to true behind a reverse proxy, so rate limits see the real client IP
# from X-Forwarded-For instead of the proxy's.
# HOOKTOPUS_TRUST_PROXY=false

# How long a bin lives. Fractions are fine: 0.05 is three minutes.
# HOOKTOPUS_BIN_TTL_HOURS=24

# Above this, captures are refused with 507 until expired bins free space.
# HOOKTOPUS_MAX_STORAGE_MB=1024

# Kill switch for server-side forwarding, in case someone abuses it.
# HOOKTOPUS_FORWARD_ENABLED=true
